{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "上课鸭",
  "version": "1.0.5",
  "identifier": "com.shangkeya.teacher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:32178",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist/client"
  },
  "app": {
    "withGlobalTauri": true,
    "appDirectoriesOverride": "./app-data",
    "windows": [
      {
        "label": "main",
        "title": "上课鸭—教学课程管理系统",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

