<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- macOS 默认 ATS 会拦截明文 HTTP 请求；后端 API 目前走 http://82.156.240.204，
         不放开会导致验证码、登录等所有接口请求失败（表现为"无法连接服务器"）。
         NSAllowsArbitraryLoadsInWebContent 对 WKWebView 生效，NSAllowsArbitraryLoads 覆盖面更广。 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
    </dict>
    <!-- 声明应用为简体中文应用：系统文件选择框（打开/保存/选择文件夹）的按钮与标题随之显示中文，
         否则未声明本地化的应用在中文 macOS 上仍会弹出英文的 Open/Cancel。 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>zh_CN</string>
        <string>zh-Hans</string>
        <string>en</string>
    </array>
</dict>
</plist>
